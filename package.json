{
    "name": "jaba",
    "version": "5.7.0",
    "main": "src/index.js",
    "type": "module",
    "scripts": {
        "start": "NODE_ENV=production node dist/index.js",
        "dev": "NODE_ENV=dev tsx src/index.ts",
        "build": "rimraf tsconfig.tsbuildinfo dist && tsc && tsc-alias",
        "postbuild": "cpx \"src/**/*.{json,png}\" dist",
        "dev:dashboard": "pnpm --filter @jaba/dashboard dev",
        "build:dashboard": "pnpm --filter @jaba/dashboard build",
        "delete-commands": "tsx delete-commands.ts",
        "pm2": "NODE_ENV=production pm2 start --name jaba dist/index.js"
    },
    "author": "https://github.com/JonnyBro",
    "dependencies": {
        "@fastify/cookie": "^11.1.3",
        "@fastify/session": "^11.1.5",
        "@fastify/static": "^8.3.0",
        "@fastify/websocket": "^11.3.4",
        "chalk": "^5.4.1",
        "cpx": "^1.5.0",
        "cron": "^4.1.0",
        "discord.js": "^14.27.0",
        "dotenv": "^17.3.1",
        "fastify": "^5.12.7",
        "i18next": "^24.2.2",
        "i18next-fs-backend": "^2.6.0",
        "lavalink-client": "2.11.0",
        "md5": "^2.3.0",
        "mongoose": "^8.12.1",
        "ms": "^2.1.3",
        "node-fetch": "^3.3.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.21.0",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/md5": "^2.3.5",
        "@types/ms": "^2.1.0",
        "@types/node": "^22.13.9",
        "@typescript-eslint/eslint-plugin": "^8.57.0",
        "@typescript-eslint/parser": "^8.57.0",
        "eslint": "^9.21.0",
        "globals": "^16.0.0",
        "prettier": "^3.5.3",
        "prettier-eslint": "17.0.0-alpha.1",
        "rimraf": "^6.0.1",
        "tsc-alias": "^1.8.16",
        "tsx": "^4.20.3",
        "typescript": "^5.9.3"
    },
    "packageManager": "pnpm@12.15.0",
    "engines": {
        "npm": ">=10.9.8",
        "node": ">=22.23.0"
    }
}
