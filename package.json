{
    "name": "jaba",
    "version": "6.3.0",
    "main": "src/index.js",
    "type": "module",
    "scripts": {
        "start": "NODE_ENV=production node dist/index.js",
        "dev": "pnpm run \"/^(bot|dashboard):dev$/\"",
        "build": "pnpm bot:build && pnpm dashboard:build",
        "bot:dev": "NODE_ENV=dev tsx src/index.ts",
        "bot:build": "rimraf tsconfig.tsbuildinfo dist && tsc && tsc-alias && cpx \"src/**/*.{json,png}\" dist",
        "dashboard:dev": "pnpm --filter @jaba/dashboard dev",
        "dashboard:build": "pnpm --filter @jaba/dashboard build",
        "delete-commands": "tsx delete-commands.ts",
        "pm2": "NODE_ENV=production pm2 start --name jaba dist/index.js"
    },
    "author": "https://github.com/JonnyBro",
    "dependencies": {
        "@fastify/cookie": "^11.1.5",
        "@fastify/multipart": "^10.1.6",
        "@fastify/session": "^11.1.6",
        "@fastify/static": "^10.1.8",
        "@fastify/websocket": "^11.3.4",
        "chalk": "^6.0.1",
        "cpx": "^1.5.0",
        "cron": "^4.4.0",
        "discord.js": "^14.27.0",
        "dotenv": "^18.0.9",
        "fastify": "^5.12.7",
        "i18next": "^26.5.11",
        "i18next-fs-backend": "^2.6.9",
        "lavalink-client": "2.11.0",
        "md5": "^2.3.0",
        "mongoose": "^9.11.4",
        "ms": "^2.1.3",
        "node-fetch": "^3.3.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/md5": "^2.3.6",
        "@types/ms": "^2.1.0",
        "@types/node": "^22.20.5",
        "@typescript-eslint/eslint-plugin": "^8.72.1",
        "@typescript-eslint/parser": "^8.72.1",
        "eslint": "^10.13.0",
        "globals": "^17.13.0",
        "prettier": "^3.9.10",
        "prettier-eslint": "^17.1.2",
        "rimraf": "^6.1.3",
        "tsc-alias": "^1.9.9",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3"
    },
    "packageManager": "pnpm@12.15.0",
    "engines": {
        "npm": ">=10.9.8",
        "node": ">=22.23.0"
    }
}
