# Discord Bot Token
TOKEN=XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Client ID - Used by the "delete-commands" script and the dashboard login
CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Dashboard (leave DASHBOARD_URL empty to disable it)
# Add "<DASHBOARD_URL>/auth/callback" to OAuth2 redirects in the Discord Developer Portal
# In development use http://localhost:5173, Vite proxies /api and /auth to the bot
CLIENT_SECRET=
DASHBOARD_URL=http://localhost:6548
DASHBOARD_PORT=6548

# At least 32 characters, e.g. from `openssl rand -hex 32`
DASHBOARD_SECRET=
DASHBOARD_BEHIND_PROXY=false

# Address Lavalink uses to download music files uploaded in the dashboard, defaults to http://localhost:<DASHBOARD_PORT>
# docker-compose.yaml sets it to "http://jaba:6548" automatically
DASHBOARD_INTERNAL_URL=
# Where uploaded music files are stored, defaults to the "uploads" folder in the bot directory
UPLOADS_DIR=

# MongoDB Connection String
# Replace "localhost:27017" with "mongo" if you are using the MongoDB container
MONGODB_URI=mongodb://localhost:27017/discordbot

# Lavalink (music)
# docker-compose.yaml sets the host to "lavalink" for the bot container automatically
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false

# Minutes Lavalink keeps the music playing while the bot is down, 0 to disable resuming
MUSIC_RESUME_TIMEOUT=10

# Production?
PROD=true

# Guild IDs to Register devOnly Commands to
# Separated by spaces
DEV_GUILDS_IDS="123456789098765432 987654321012345678"

# Channel ID for Join/Leave Logs
DEV_LOGS_JOINS="123456789098765432"

# Settings for Embeds
EMBED_COLOR="#00FF00"
EMBED_FOOTER=My Discord Bot | v1.0.0

# Bot's Owner User ID
OWNER="123456789098765432"

# Default Bot's Language
DEFAULT_LANG=en-US

# URL Shortener
URL_SHORTENER_URL=
URL_SHORTENER_KEY=

# Commands Settings

## How long to wait before `8ball` to response (ms)
COMMAND_8BALL_TYPING_TIME=2500
